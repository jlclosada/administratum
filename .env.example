# Supabase — copia estos valores desde tu proyecto en https://app.supabase.com
# Project Settings > API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key

# Email de la cuenta administradora (acceso al panel /admin).
# Debe coincidir con el email usado en la policy de app_config en schema.sql.
VITE_ADMIN_EMAIL=jlcaclosada@gmail.com

# Solo para el cron diario (GitHub Actions / npm run sync:mfm). No usar en el cliente.
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
