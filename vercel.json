{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "administratum.vercel.app"
        }
      ],
      "destination": "https://administratum.site/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "administratum.vercel.app"
        }
      ],
      "destination": "https://administratum.site/:path+",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/catalogo-puntos",
      "destination": "/api/render?path=/catalogo-puntos"
    },
    {
      "source": "/catalogo-puntos/:slug",
      "destination": "/api/render?path=/catalogo-puntos/:slug"
    },
    {
      "source": "/articulos/:id",
      "destination": "/api/render?path=/articulos/:id"
    },
    {
      "source": "/guias",
      "destination": "/api/render?path=/guias"
    },
    {
      "source": "/guias/:id",
      "destination": "/api/render?path=/guias/:id"
    },
    {
      "source": "/competitivo",
      "destination": "/api/render?path=/competitivo"
    },
    {
      "source": "/competitivo/torneos/:id",
      "destination": "/api/render?path=/competitivo/torneos/:id"
    },
    {
      "source": "/competitivo/listas/:id",
      "destination": "/api/render?path=/competitivo/listas/:id"
    },
    {
      "source": "/comunidad",
      "destination": "/api/render?path=/comunidad"
    },
    {
      "source": "/comunidad/listas/:id",
      "destination": "/api/render?path=/comunidad/listas/:id"
    },
    {
      "source": "/perfil/:id",
      "destination": "/api/render?path=/perfil/:id"
    },
    {
      "source": "/descargas",
      "destination": "/api/render?path=/descargas"
    },
    {
      "source": "/((?!assets/|api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!assets/|api/|sitemap\\.xml).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/email?action=cron",
      "schedule": "0 9 * * *"
    }
  ]
}
