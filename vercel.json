{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "administratum.vercel.app"
        }
      ],
      "destination": "https://administratum.site/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "administratum.vercel.app"
        }
      ],
      "destination": "https://administratum.site/:path+",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/render?path=/"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/llms"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/api/llms?full=1"
    },
    {
      "source": "/sobre",
      "destination": "/api/render?path=/sobre"
    },
    {
      "source": "/en",
      "destination": "/api/render?path=/en"
    },
    {
      "source": "/partidas",
      "destination": "/api/render?path=/partidas"
    },
    {
      "source": "/partidas/:id",
      "destination": "/api/render?path=/partidas/:id"
    },
    {
      "source": "/catalogo-puntos",
      "destination": "/api/render?path=/catalogo-puntos"
    },
    {
      "source": "/catalogo-puntos/:slug",
      "destination": "/api/render?path=/catalogo-puntos/:slug"
    },
    {
      "source": "/catalogo-puntos/:slug/:unit",
      "destination": "/api/render?path=/catalogo-puntos/:slug/:unit"
    },
    {
      "source": "/articulos/:id",
      "destination": "/api/render?path=/articulos/:id"
    },
    {
      "source": "/guias",
      "destination": "/api/render?path=/guias"
    },
    {
      "source": "/guias/:id",
      "destination": "/api/render?path=/guias/:id"
    },
    {
      "source": "/competitivo",
      "destination": "/api/render?path=/competitivo"
    },
    {
      "source": "/competitivo/torneos/:id",
      "destination": "/api/render?path=/competitivo/torneos/:id"
    },
    {
      "source": "/competitivo/listas/:id",
      "destination": "/api/render?path=/competitivo/listas/:id"
    },
    {
      "source": "/comunidad",
      "destination": "/api/render?path=/comunidad"
    },
    {
      "source": "/comunidad/listas/:id",
      "destination": "/api/render?path=/comunidad/listas/:id"
    },
    {
      "source": "/perfil/:id",
      "destination": "/api/render?path=/perfil/:id"
    },
    {
      "source": "/descargas",
      "destination": "/api/render?path=/descargas"
    },
    {
      "source": "/cambios-puntos",
      "destination": "/api/render?path=/cambios-puntos"
    },
    {
      "source": "/((?!assets/|api/).*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://connect.facebook.net; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' https://qqfggcpdphuadsicutsb.supabase.co wss://qqfggcpdphuadsicutsb.supabase.co https://*.ingest.de.sentry.io https://nominatim.openstreetmap.org https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://www.facebook.com; frame-src 'self' https://www.facebook.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=(), usb=(), browsing-topics=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!assets/|api/|sitemap\\.xml).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/app.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/email?action=cron",
      "schedule": "0 9 * * *"
    }
  ],
  "functions": {
    "api/mfm-sync.ts": {
      "maxDuration": 300
    },
    "api/render.ts": {
      "includeFiles": "dist/app.html"
    }
  }
}
